{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "prepare": "sass --load-path=node_modules --load-path=node_modules/smui-theme/node_modules src/theme/styles.scss public/smui.css --style=compressed --no-source-map && sass --load-path=node_modules --load-path=node_modules/smui-theme/node_modules src/theme/dark/styles.scss public/smui-dark.css --style=compressed --no-source-map"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@smui/banner": "^9.0.2",
    "@smui/button": "^9.0.0",
    "@smui/card": "^9.0.0",
    "@smui/checkbox": "^9.0.2",
    "@smui/common": "^9.0.0",
    "@smui/dialog": "^9.0.2",
    "@smui/floating-label": "^9.0.2",
    "@smui/form-field": "^9.0.2",
    "@smui/icon-button": "^9.0.0",
    "@smui/line-ripple": "^9.0.2",
    "@smui/linear-progress": "^9.0.2",
    "@smui/list": "^9.0.2",
    "@smui/menu": "^9.0.2",
    "@smui/menu-surface": "^9.0.2",
    "@smui/notched-outline": "^9.0.2",
    "@smui/ripple": "^9.0.0",
    "@smui/slider": "^9.0.2",
    "@smui/textfield": "^9.0.0",
    "@smui/top-app-bar": "^9.0.2",
    "@smui/touch-target": "^9.0.0",
    "dompurify": "^3.2.0",
    "marked": "^18.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/dompurify": "^3.2.0",
    "jsdom": "^30.1.1",
    "sass": "^1.90.0",
    "smui-theme": "^9.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
